# Database
DATABASE_URL=

# Authentication
BETTER_AUTH_API_KEY=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# Email (Nodemailer SMTP) – powers transactional emails (email verification, …)
# Replace these placeholders with real credentials (e.g. a Gmail app password
# or a Mailtrap sandbox inbox) – verification emails cannot be sent without them.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Stripe – payment processing
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Cloudinary – signed uploads for product media (server-side only)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=

# Internal job scheduling
# CRON_SECRET is used to authenticate internal job endpoints (e.g. expired reservation worker)
# Generate a strong random string: openssl rand -hex 32
CRON_SECRET=

# Notification retry worker (optional; defaults shown)
# NOTIFICATION_BATCH_SIZE=50
# NOTIFICATION_MAX_ATTEMPTS=5
# NOTIFICATION_LEASE_MINUTES=10

# Guest cart cookie integrity (required in production; dev-only fallback otherwise)
# Generate a strong random string: openssl rand -hex 32
# GUEST_CART_SECRET=

# Low-stock alert recipients (optional, comma-separated emails)
# LOW_STOCK_ALERT_RECIPIENTS=

# Reservation expiration configuration
# RESERVATION_EXPIRY_MINUTES: How long a checkout reservation is valid before expiring (default: 30 minutes)
RESERVATION_EXPIRY_MINUTES=30

# EXPIRED_RESERVATION_BATCH_SIZE: Maximum number of expired orders to process per job run (default: 100)
EXPIRED_RESERVATION_BATCH_SIZE=100

# EXPIRED_RESERVATION_MAX_RETRIES: Maximum retry attempts for failed order processing (default: 3)
EXPIRED_RESERVATION_MAX_RETRIES=3